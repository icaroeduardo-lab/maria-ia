LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=
# API interna da DPERJ (Fase 3) — vazio = modo mock (protocolo local)
DPERJ_API_URL=
DPERJ_API_KEY=
# Verde/DPERJ direto (src/core/verde-direto.ts, decisão 2026-08-26) — sem
# VERDE_JWT_TOKEN/VERDE_CLIENT_ID as rotas de fluxo que dependem do Verde
# ficam sem dado (ou caem no fallback local, quando existe). TEMPORÁRIO: JWT
# emitido como app "Tykhe", expira 2026-09-12 — ver TODO no topo do arquivo.
# VERDE_API_URL=https://homologacao.verde.rj.def.br/api/integra
VERDE_JWT_TOKEN=
VERDE_CLIENT_ID=
# WhatsApp Business Cloud API (Fase 4) — sem WA_ACCESS_TOKEN o sender só loga
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_WEBHOOK_VERIFY_TOKEN=
# WA_GRAPH_URL=https://graph.facebook.com
# WA_API_VERSION=v23.0
# Postgres + admin
DATABASE_URL=postgresql://mariachat:mariachat_dev@localhost:5432/mariachat
REDIS_URL=redis://localhost:6379
JWT_SECRET=
SEED_ADMIN_PASSWORD=
# Base do próprio servidor p/ chamadas internas do fluxo (nós API com url relativa /api/...)
# default http://localhost:PORT — definir só se o servidor não se alcança nesse host
SELF_URL=
# Bucket S3 para fichas (default maria-ia)
S3_BUCKET=
# TEMPORÁRIO — só para apresentação/demo (ver comentário no topo de
# src/api/routes/documentos.ts). "true" = POST /api/documentos/verificar
# SEMPRE responde match:true, sem tocar S3/Textract. Default false/ausente =
# comportamento real. NUNCA deixar "true" fora da janela da apresentação —
# instruções de ligar/desligar em produção (Secrets Manager + ECS, sem novo
# deploy) no comentário do topo daquele arquivo.
DEMO_OCR_SEMPRE_PASSA=
